{
  "manifest_version": 3,
  "name": "GitHub Word Diff",
  "version": "1.0.0",
  "description": "Highlights only the changed words in long changed lines of GitHub diffs, instead of the whole line.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/diff.js", "src/content.js"],
      "css": ["src/content.css"],
      "run_at": "document_idle"
    }
  ]
}
